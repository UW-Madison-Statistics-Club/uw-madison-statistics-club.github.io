---
import Layout from "../layouts/Layout.astro";
import { upcomingEvents, pastEvents, formatEventDate } from "../data/events.js";

const base = import.meta.env.BASE_URL;
---

<Layout title="Events" description="Upcoming meetings, workshops, and socials from the UW–Madison Statistics Club.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Events</p>
      <h1>Upcoming Events</h1>
      <div class="event-list">
        {
          upcomingEvents.map((event) => (
            <div class:list={["card event-card", { "key-date": event.type === "date" }]}>
              <div class="event-date">
                <span class="date-main">{formatEventDate(event)}</span>
                {event.time && <span class="date-time">{event.time}</span>}
              </div>
              <div class="event-body">
                {event.type === "date" && <span class="key-date-tag">Key date</span>}
                <h3>{event.title}</h3>
                {event.location && <p class="event-location">{event.location}</p>}
                {event.description && <p>{event.description}</p>}
                {event.dataChallenge && (
                  <a class="event-link" href={`${base}data-challenge/`}>Data Challenge details &rarr;</a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <h2>Past Events</h2>
      <ul class="past-list">
        {
          pastEvents.map((event) => (
            <li>
              <span class="past-date">{formatEventDate(event)}</span>
              <span class="past-title">{event.title}</span>
              {event.description && <span class="past-desc">{event.description}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .event-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .event-card {
    display: flex;
    gap: 1.5rem;
  }

  .event-date {
    flex: 0 0 8rem;
    display: flex;
    flex-direction: column;
    color: var(--badger-red);
    font-weight: 700;
  }

  .date-time {
    color: var(--ink-soft);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .key-date {
    background: transparent;
    border-style: dashed;
    padding-block: 0.75rem;
    align-items: center;
  }

  .key-date h3 {
    margin: 0;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .key-date .date-main {
    color: var(--ink-soft);
  }

  .key-date-tag {
    display: inline-block;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .event-link {
    font-weight: 600;
  }

  .event-location {
    color: var(--ink-soft);
    font-weight: 600;
    margin-top: -0.5rem;
  }

  .past-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .past-list li {
    display: grid;
    grid-template-columns: 8rem 1fr 2fr;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .past-date {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .past-title {
    font-weight: 600;
  }

  .past-desc {
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .event-card {
      flex-direction: column;
    }

    .event-date {
      flex-direction: row;
      gap: 0.5rem;
    }

    .past-list li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
